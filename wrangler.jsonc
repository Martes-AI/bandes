{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bandes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Il modello che valuta i bandi, da OpenRouter. Uno economico basta: legge al massimo 20 schede.
    "MODELLO": "deepseek/deepseek-v4.1-flash"
  },
  // Al massimo 5 valutazioni al minuto per indirizzo IP: la chiave OpenRouter la paga chi pubblica l'app.
  "ratelimits": [
    { "name": "LIMITE_AI", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_PIVA", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Il catalogo aggiornato ogni notte. Senza id, wrangler crea il namespace da solo al primo deploy.
  "kv_namespaces": [{ "binding": "CATALOGO" }],
  // Ogni giorno alle 5:15 UTC scarica Incentivi Italia e aggiorna il catalogo in KV.
  "triggers": { "crons": ["15 5 * * *"] },
  "observability": { "enabled": true }
}
